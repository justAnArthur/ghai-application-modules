# internal (in memory, seeded demo users) or sql (PostgreSQL; fill in the DATABASE_ values)
REPOSITORY_TYPE=internal

DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=
DATABASE_PORT=

# relative path from the `server` directory
SQL_INIT_FILE=db/schema.sql

PATH_TO_SAVE_FILES=./files

CREDENTIALS_FILE=/.ghai
